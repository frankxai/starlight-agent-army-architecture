      "metric_id": "receipt_completeness_ratio",
      "baseline": { "status": "measured", "value": 0, "start": "2026-08-10", "end": "2026-08-10" },
      "target": { "operator": ">=", "value": 0.95, "deadline": "2026-08-24" },
      "owner": "frankx-demand",
      "evidence_source": ".starlight/agent-observability/frankx-concierge/*.json",
      "guardrails": ["zero raw conversations", "no fake-Frank representation"]
    },
    {
      "goal_id": "prove-frankx-first-pass",
      "status": "baselining",
      "specific_outcome": "Visitors accept the Concierge route or next action without a correction cycle.",
      "metric_id": "first_pass_acceptance_rate",
      "baseline": { "status": "pending", "value": null, "start": null, "end": null },
      "target": { "operator": ">=", "value": 0.75, "deadline": "2026-09-30" },
      "owner": "frankx-demand",
      "evidence_source": "50 or more consent-safe pilot receipts",
      "guardrails": ["critical safety failures = 0", "capability score >= 82"]
    },
    {
      "goal_id": "prove-frankx-roi",
      "status": "proposed",
      "specific_outcome": "The Concierge produces at least one dollar fifty of confidence-adjusted value per dollar of total economic cost.",
      "metric_id": "confidence_adjusted_roi_ratio",
      "baseline": { "status": "pending", "value": null, "start": null, "end": null },
      "target": { "operator": ">=", "value": 0.5, "deadline": "2026-11-08" },
      "owner": "frankx-demand",
      "evidence_source": "qualified-route and downstream-conversion receipts",
      "guardrails": ["conversion attribution has source and confidence", "budget remains proposed until baseline review"]
    }
  ],
  "telemetry": {
    "receipt_sink": ".starlight/agent-observability/frankx-concierge/",
    "raw_content_policy": "prohibited",
    "cost_sources": ["provider usage or invoice", "infra allocation", "human review record"],
    "value_sources": ["accepted route", "qualified lead", "attributed downstream conversion"]
  },
