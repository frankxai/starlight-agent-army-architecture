{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.ai/schemas/civilization-graph.v2.json",
  "title": "Starlight Civilization graph v2",
  "type": "object",
  "required": ["schema_version", "status", "source_portfolio_id", "source_portfolio_version", "source_portfolio_digest", "identity_lock_digest", "counts", "node_types", "edge_types", "nodes", "edges", "workflow_contracts"],
  "properties": {
    "schema_version": { "const": "starlight.civilization_graph.v2" },
    "status": { "const": "public_architecture_projection" },
    "source_portfolio_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity_lock_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "counts": {
      "type": "object",
      "required": ["nodes", "edges", "workflows"],
      "properties": { "workflows": { "const": 8 } }
    },
    "node_types": { "type": "array", "contains": { "const": "failure_state" } },
    "edge_types": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "verifies" } },
        { "contains": { "const": "failure_routes_to" } },
        { "contains": { "const": "loops_to" } }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type", "provenance", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^edge-[0-9a-f]{16}$" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflow_contracts": { "type": "array", "minItems": 8, "maxItems": 8 }
  }
}
