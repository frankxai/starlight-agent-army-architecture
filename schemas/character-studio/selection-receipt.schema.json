{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlightintelligence.org/schemas/character-studio/selection-receipt.schema.json",
  "title": "Starlight Character Selection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "agent_id",
    "batch_id",
    "candidates",
    "recommendation",
    "selected_job",
    "rationale",
    "independent_reviewer",
    "human_decision",
    "created_at"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "starlight.character_selection_receipt.v1" },
    "receipt_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "batch_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_ref", "territory_id", "artifact_path", "sha256", "inspected", "score30", "strongest_element", "weakest_element", "verdict"],
        "properties": {
          "job_ref": { "$ref": "#/$defs/repoPath" },
          "territory_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "artifact_path": { "$ref": "#/$defs/repoPath" },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "inspected": { "type": "boolean" },
          "score30": { "type": ["integer", "null"], "minimum": 0, "maximum": 30 },
          "strongest_element": { "type": "string" },
          "weakest_element": { "type": "string" },
          "verdict": { "type": "string", "enum": ["pending", "eligible", "iterate", "restart", "rejected"] }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["pending", "select", "blend", "iterate", "restart"]
    },
    "selected_job": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/repoPath" }
      ]
    },
    "rationale": { "type": "string" },
    "independent_reviewer": { "type": "string", "minLength": 2 },
    "human_decision": { "type": "string", "enum": ["pending", "approve", "iterate", "restart"] },
    "created_at": { "type": "string", "format": "date" }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "recommendation": { "enum": ["select", "blend"] } } },
      "then": { "properties": { "selected_job": { "type": "string" } } }
    },
    {
      "if": { "properties": { "human_decision": { "const": "approve" } } },
      "then": {
        "properties": {
          "recommendation": { "enum": ["select", "blend"] },
          "selected_job": { "type": "string" }
        }
      }
    }
  ]
}
