{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.local/schemas/agent-portfolio-review.schema.json",
  "title": "Starlight Monthly Agent Estate Portfolio Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cadence",
    "generated_at",
    "period",
    "execution_status",
    "outcome_status",
    "authority",
    "coverage",
    "summary",
    "runtime_mix",
    "assignments",
    "input_errors",
    "portfolio_decisions"
  ],
  "properties": {
    "schema_version": { "const": "agent-portfolio-review.v1" },
    "cadence": { "const": "monthly" },
    "generated_at": { "type": "string", "format": "date-time" },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "execution_status": { "enum": ["ok", "error", "skipped"] },
    "outcome_status": { "enum": ["VERIFIED", "HOLD", "BLOCKED", "NOOP", "FAILED"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "human_owner", "automatic_state_change"],
      "properties": {
        "mode": { "const": "advisory" },
        "human_owner": { "type": "string", "minLength": 1 },
        "automatic_state_change": { "const": false }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly_reviews_observed", "weekly_reviews_required", "assignments"],
      "properties": {
        "weekly_reviews_observed": { "type": "integer", "minimum": 0 },
        "weekly_reviews_required": { "type": "integer", "minimum": 1 },
        "assignments": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RED", "AMBER", "GREEN", "PAUSED", "decision_counts", "total_runs"],
      "properties": {
        "RED": { "type": "integer", "minimum": 0 },
        "AMBER": { "type": "integer", "minimum": 0 },
        "GREEN": { "type": "integer", "minimum": 0 },
        "PAUSED": { "type": "integer", "minimum": 0 },
        "decision_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "total_runs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "runtime_mix": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "agent_id",
          "runtime",
          "lifecycle_status",
          "weekly_reviews_observed",
          "exposure_counts",
          "latest_exposure",
          "decision",
          "utilization",
          "economics",
          "goals",
          "limitations"
        ],
        "properties": {
          "assignment_id": { "type": "string", "minLength": 1 },
          "agent_id": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "minLength": 1 },
          "lifecycle_status": { "type": "string", "minLength": 1 },
          "weekly_reviews_observed": { "type": "integer", "minimum": 0 },
          "exposure_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["RED", "AMBER", "GREEN", "PAUSED"],
            "properties": {
              "RED": { "type": "integer", "minimum": 0 },
              "AMBER": { "type": "integer", "minimum": 0 },
              "GREEN": { "type": "integer", "minimum": 0 },
              "PAUSED": { "type": "integer", "minimum": 0 }
            }
          },
          "latest_exposure": { "type": ["string", "null"], "enum": ["RED", "AMBER", "GREEN", "PAUSED", null] },
          "decision": {
            "enum": [
              "SECURITY_AND_REMEDIATION_REVIEW",
              "HOLD_FOR_EVIDENCE",
              "IMPROVEMENT_PLAN",
              "SCALE_REVIEW_ELIGIBLE",
              "CONTINUE",
              "MAINTAIN_NO_DISPATCH"
            ]
          },
          "utilization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runs", "successful_outcomes", "model_calls", "tool_calls", "durable_artifact_rate"],
            "properties": {
              "runs": { "type": ["integer", "null"], "minimum": 0 },
              "successful_outcomes": { "type": ["integer", "null"], "minimum": 0 },
              "model_calls": { "type": ["integer", "null"], "minimum": 0 },
              "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
              "durable_artifact_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          },
          "economics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actual_cash_cost_usd", "total_economic_cost_usd", "confidence_adjusted_value_usd", "confidence_adjusted_roi_ratio"],
            "properties": {
              "actual_cash_cost_usd": { "type": ["number", "null"], "minimum": 0 },
              "total_economic_cost_usd": { "type": ["number", "null"], "minimum": 0 },
              "confidence_adjusted_value_usd": { "type": ["number", "null"], "minimum": 0 },
              "confidence_adjusted_roi_ratio": { "type": ["number", "null"] }
            }
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["goal_id", "status", "metric_id", "target", "deadline", "latest_value"],
              "properties": {
                "goal_id": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 },
                "metric_id": { "type": "string", "minLength": 1 },
                "target": { "type": "number" },
                "deadline": { "type": "string", "format": "date" },
                "latest_value": { "type": ["number", "null"] }
              }
            }
          },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "input_errors": { "type": "array", "items": { "type": "string" } },
    "portfolio_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
