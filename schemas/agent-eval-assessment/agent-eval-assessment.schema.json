{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.local/schemas/agent-eval-assessment.schema.json",
  "title": "Starlight Independent Agent Evaluation Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "assignment_id",
    "agent_id",
    "suite_id",
    "mode",
    "runtime",
    "assessor",
    "passed",
    "total",
    "rate",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "agent-eval-assessment.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "assignment_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "agent_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "suite_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "live" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "model", "artifact_digests"],
      "properties": {
        "executor": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "independent"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "independent": { "const": true }
      }
    },
    "passed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 1 },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "raw_receipt_ref": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
