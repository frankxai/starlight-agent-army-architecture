{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.local/schemas/n8n-agent-automation-handoff.schema.json",
  "title": "Starlight Agent Estate to n8n Automation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "deployment_status",
    "owner",
    "estate_contract_refs",
    "target",
    "blockers",
    "execution_chain",
    "event_contract",
    "authority",
    "receipt_contract"
  ],
  "properties": {
    "schema_version": { "const": "n8n-agent-automation-handoff.v1" },
    "handoff_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "deployment_status": { "enum": ["design-only", "blocked", "pilot-authorized", "active", "retired"] },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_portfolio", "agent_estate", "human_owner"],
      "properties": {
        "automation_portfolio": { "type": "string", "minLength": 1 },
        "agent_estate": { "const": "starlight-queen" },
        "human_owner": { "type": "string", "minLength": 1 }
      }
    },
    "estate_contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queen", "workforce", "access_bundle", "swarm_mission"],
      "properties": {
        "queen": { "$ref": "#/$defs/repoRef" },
        "workforce": { "$ref": "#/$defs/repoRef" },
        "access_bundle": { "$ref": "#/$defs/repoRef" },
        "swarm_mission": { "$ref": "#/$defs/repoRef" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_ref", "zone", "workflow_id", "activation_requested", "authentication_status"],
      "properties": {
        "instance_ref": { "type": "string", "minLength": 1 },
        "zone": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "workflow_id": { "type": ["string", "null"] },
        "activation_requested": { "type": "boolean" },
        "authentication_status": { "enum": ["unverified", "required", "verified", "revoked"] }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "execution_chain": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "AuthenticatedIntake" },
        { "const": "NormalizeValidate" },
        { "const": "IdempotentLedgerUpsert" },
        { "const": "PolicyRiskGate" },
        { "const": "HumanApprovalResume" },
        { "const": "DeterministicAction" },
        { "const": "ReceiptMetrics" },
        { "const": "ErrorDLQIncident" }
      ],
      "items": false
    },
    "event_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_at_intake", "required_before_action", "receipt_fields", "forbidden_fields", "payload_policy"],
      "properties": {
        "required_at_intake": { "$ref": "#/$defs/uniqueFieldList" },
        "required_before_action": { "$ref": "#/$defs/uniqueFieldList" },
        "receipt_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "forbidden_fields": { "$ref": "#/$defs/uniqueFieldList" },
        "payload_policy": { "const": "opaque-reference-only" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_can_assert_approval", "workflow_can_assert_security_pass", "workflow_can_promote", "consequential_action_gate"],
      "properties": {
        "workflow_can_assert_approval": { "const": false },
        "workflow_can_assert_security_pass": { "const": false },
        "workflow_can_promote": { "const": false },
        "consequential_action_gate": { "const": "verified-human-approval-receipt" }
      }
    },
    "receipt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_status_values", "outcome_status_values", "private_sink", "raw_content_policy"],
      "properties": {
        "execution_status_values": {
          "type": "array",
          "const": ["ok", "error", "skipped"]
        },
        "outcome_status_values": {
          "type": "array",
          "const": ["VERIFIED", "HOLD", "BLOCKED", "NOOP", "FAILED"]
        },
        "private_sink": { "type": "string", "pattern": "^private:" },
        "raw_content_policy": { "const": "prohibited" }
      }
    }
  },
  "$defs": {
    "repoRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "uniqueFieldList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    }
  }
}
